# shield-access.env.example — copy to shield-access.env (gitignored) and fill in.
# Holds the REAL server topology so it never lands in the PUBLIC repo. Sourced on DEVIL
# by the provisioning flow (authorize-shield-keys.ps1 + the provision-access.sh exec);
# the real values reach the Shield only over the LAN and persist on-device (claude-home
# ~/.ssh/config), never in git.
#
# Starhold boxes are reached over the tailnet (SSH user `grasp`):
STARHOLD_USER=grasp
STARHOLD_DEDI=100.0.0.0        # starhold-dedi tailnet IP
STARHOLD_VPS=100.0.0.0         # starhold-vps  tailnet IP

# qflix arr stack — reached over the PUBLIC internet:
QFLIX_USER=youruser
QFLIX_HOST=host.example.net    # e.g. the arr box's public SSH hostname
